@model MuetStudentPortal.Models.Student

@{
    ViewData["Title"] = "Delete Student Record";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card card-custom border-danger p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="bg-danger-subtle text-danger p-3 rounded-circle d-inline-flex mb-3">
                    <!-- Trash Alert SVG -->
                    <svg class="svg-icon" style="width: 36px; height: 36px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        <line x1="10" y1="11" x2="10" y2="17"></line>
                        <line x1="14" y1="11" x2="14" y2="17"></line>
                    </svg>
                </div>
                <h4 class="fw-bold text-danger">Confirm Deletion</h4>
                <p class="text-muted">Are you sure you want to permanently delete this student record from the SQL database?</p>
            </div>

            <div class="bg-light p-3 rounded-3 mb-4 border">
                <div class="row g-2">
                    <div class="col-5 text-muted">Roll Number:</div>
                    <div class="col-7 fw-bold">@Model.RollNumber</div>
                    <div class="col-5 text-muted">Name:</div>
                    <div class="col-7 fw-bold">@Model.FullName</div>
                    <div class="col-5 text-muted">Department:</div>
                    <div class="col-7">@Model.Department</div>
                    <div class="col-5 text-muted">Batch:</div>
                    <div class="col-7">@Model.Batch</div>
                </div>
            </div>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-center gap-3">
                    <a asp-action="Index" class="btn btn-light border px-4">Cancel</a>
                    <button type="submit" class="btn btn-danger px-4 d-inline-flex align-items-center gap-2">
                        <svg class="svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        </svg>
                        Yes, Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>