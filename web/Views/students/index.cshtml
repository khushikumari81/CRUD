@model IEnumerable<MuetStudentPortal.Models.Student>

    @{
    ViewData["Title"] = "Students Directory";
    }

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="h3 fw-bold mb-1">Student Directory</h2>
            <p class="text-muted mb-0">Browse and manage enrolled undergraduate students of MUET.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary-muet px-3 py-2 d-inline-flex align-items-center gap-2">
            <svg class="svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="16"></line>
                <line x1="8" y1="12" x2="16" y2="12"></line>
            </svg>
            Register New Student
        </a>
    </div>

    <!-- Search & Filter Card -->
    <div class="card card-custom p-3 mb-4">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-6 col-12">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <svg class="svg-icon text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </span>
                    <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control border-start-0" placeholder="Search by Roll No, Name or Email..." />
                </div>
            </div>
            <div class="col-md-4 col-8">
                <select name="departmentFilter" class="form-select">
                    <option value="">All Departments</option>
                    <option value="Software Engineering" selected="@(ViewBag.DepartmentFilter == " Software Engineering")">Software Engineering</option>
                    <option value="Computer Systems Engineering" selected="@(ViewBag.DepartmentFilter == " Computer Systems Engineering")">Computer Systems Engineering</option>
                    <option value="Electrical Engineering" selected="@(ViewBag.DepartmentFilter == " Electrical Engineering")">Electrical Engineering</option>
                    <option value="Civil Engineering" selected="@(ViewBag.DepartmentFilter == " Civil Engineering")">Civil Engineering</option>
                    <option value="Telecommunication Engineering" selected="@(ViewBag.DepartmentFilter == " Telecommunication Engineering")">Telecommunication Engineering</option>
                    <option value="Mechanical Engineering" selected="@(ViewBag.DepartmentFilter == " Mechanical Engineering")">Mechanical Engineering</option>
                </select>
            </div>
            <div class="col-md-2 col-4 d-grid">
                <button type="submit" class="btn btn-dark">Filter</button>
            </div>
        </form>
    </div>

    <!-- Students Data Table -->
    <div class="card card-custom">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" class="ps-4">Roll No</th>
                        <th scope="col">Student Name</th>
                        <th scope="col">Department</th>
                        <th scope="col">Batch</th>
                        <th scope="col">CGPA</th>
                        <th scope="col">Contact</th>
                        <th scope="col" class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                    foreach (var student in Model)
                    {
                    <tr>
                        <td class="ps-4">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-semibold px-2 py-1">
                                @student.RollNumber
                            </span>
                        </td>
                        <td>
                            <div class="fw-semibold">@student.FullName</div>
                            <div class="text-muted small">@student.Email</div>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@student.Department</span>
                        </td>
                        <td>@student.Batch</td>
                        <td>
                            @if (student.Cgpa >= 3.5m)
                            {
                            <span class="badge bg-success-subtle text-success border border-success-subtle fw-bold">@student.Cgpa.ToString("0.00")</span>
                            }
                            else if (student.Cgpa >= 2.5m)
                            {
                            <span class="badge bg-info-subtle text-info border border-info-subtle fw-bold">@student.Cgpa.ToString("0.00")</span>
                            }
                            else
                            {
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle fw-bold">@student.Cgpa.ToString("0.00")</span>
                            }
                        </td>
                        <td class="small text-muted">@student.PhoneNumber</td>
                        <td class="text-end pe-4">
                            <div class="btn-group btn-group-sm" role="group">
                                <!-- View Details Button -->
                                <a asp-action="Details" asp-route-id="@student.Id" class="btn btn-outline-secondary" title="View Details">
                                    <svg class="svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                </a>
                                <!-- Edit Button -->
                                <a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-outline-primary" title="Edit Student">
                                    <svg class="svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                    </svg>
                                </a>
                                <!-- Delete Button -->
                                <a asp-action="Delete" asp-route-id="@student.Id" class="btn btn-outline-danger" title="Delete Student">
                                    <svg class="svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="3 6 5 6 21 6"></polyline>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                    </svg>
                                </a>
                            </div>
                        </td>
                    </tr>
                    }
                    }
                    else
                    {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <svg class="svg-icon mb-2 text-secondary" style="width: 2.5rem; height: 2.5rem;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="8" y1="15" x2="16" y2="15"></line>
                                <line x1="9" y1="9" x2="9.01" y2="9"></line>
                                <line x1="15" y1="9" x2="15.01" y2="9"></line>
                            </svg>
                            <div>No students found in the database.</div>
                        </td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
